Time Complexity:
O(n)

Space Complexity:
O(n)

Approach:
1. Create a HashMap to store element-value and index pairs
2. Traverse the array once
3. For each element, calculate its complement as target - nums[i]
4. Check if the complement already exists in the HashMap
5. If found, store the complement's index and current index in the answer array
6. Otherwise, store the current element and its index in the HashMap
7. Return the answer array



class Solution {
    public int[] twoSum(int[] nums, int target) {
        HashMap<Integer, Integer> map = new HashMap<>();
        int ans[] = new int[2];
        for(int i=0; i<nums.length; i++){
            int n = target-nums[i];
            if(map.containsKey(n)) {
                ans[0] = map.get(n);
                ans[1] = i;
                break;
            }
            map.put(nums[i], i);
        }
        return ans;
    }
}
