Time Complexity:
O(n²)

Space Complexity:
O(1)

Approach:
1. Traverse each index as a starting point of the substring
2. Maintain count of 'T' and 'F' for every substring
3. Extend the substring using another loop
4. Check if minimum of T and F counts is ≤ k
5. If valid, update maximum length
6. Otherwise break the loop since more changes will be required
7. Return maxLen





class Solution {
    public int maxConsecutiveAnswers(String s, int k) {
        int T = 0, F = 0;
        int maxLen = 0;
        for (int i = 0; i < s.length(); i++) {
            T = 0;
            F = 0;
            for (int j = i; j < s.length(); j++) {
                if (s.charAt(j) == 'T')
                    T++;
                else
                    F++;
                if (Math.min(T, F) <= k) {
                    maxLen = Math.max(maxLen, j - i + 1);
                }
                else break;
            }

        }
        return maxLen;
    }
}
